# Umami Analytics Configuration
# Copy this file to .env.local and fill in your values

# Backend API auth key — sent as the `x-auth-key` header on every server-side
# request to api.park.fan. Server-only (NOT NEXT_PUBLIC_): the key is never
# exposed to the browser; client requests go through the Next.js proxy routes.
# API_AUTH_KEY=

# Umami Analytics Script URL (default: cloud.umami.is)
NEXT_PUBLIC_UMAMI_URL=https://cloud.umami.is/script.js

# Your Umami Website ID from the dashboard
NEXT_PUBLIC_UMAMI_WEBSITE_ID=563fb5d1-2006-4e93-b2bd-439869690ebe

# Userback Feedback Widget
# Public access token from the Userback dashboard. When set, a floating
# "Feedback" button is shown. The Userback SDK is loaded on demand only when a
# visitor clicks that button (consent by action) — nothing is loaded and no
# personal data is processed on page load. Unset → feature disabled, no button.
# NEXT_PUBLIC_USERBACK_TOKEN=A-pAlJ4xadPr2SwQ58Zku72u74l

# Feature flags (see lib/config/features.ts) — default OFF when unset.
# Enable the animated three.js RollerCoaster-Tycoon-style 3-D park hero on the
# homepage (off → classic rotating hero photo). Accepts 1 / true / on / yes.
# NEXT_PUBLIC_HERO_3D=on

# StartupBar promo bar (startupbar.co) — a 36 px bar pinned above the page.
# Kill switch, so unlike the flags above it is ON when unset. Set it to
# off / 0 / false / no to take the bar down for a deploy without a code change.
# NEXT_PUBLIC_STARTUPBAR=off

# ──────────────────────────────────────────────────────────────────────────────
# User photo contributions (/[locale]/contribute)
# ──────────────────────────────────────────────────────────────────────────────

# Cloudflare Turnstile — bot protection for the upload form (verified once in
# /api/contribute/start). Get the keys at https://dash.cloudflare.com → Turnstile.
# Public site key (browser widget). If unset, the prototype uses Cloudflare's
# always-passes TEST key so the form still renders in local dev.
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# Secret key (server-only, used to verify the token). If unset, verification is
# SKIPPED in dev and HARD-FAILS in production (never silently open).
# TURNSTILE_SECRET_KEY=

# Storage: photos are proxied THROUGH our server to a PRIVATE Vercel Blob store
# (one request per file, each downscaled client-side to stay under Vercel's ~4.5 MB
# body limit — the browser never pushes to Blob directly). Submission metadata (the
# moderation queue) is stored as JSON in the same store.
# These are provided automatically when you link a Vercel Blob store to the project:
# BLOB_READ_WRITE_TOKEN=
# BLOB_STORE_ID=
# BLOB_WEBHOOK_PUBLIC_KEY=
# Storage driver override. Auto-detects 'vercel-blob' when BLOB_READ_WRITE_TOKEN is
# present, else 'local' (writes to ./.uploads + ./.data — offline dev only). Force with:
# STORAGE_DRIVER=local
# Secret used to HMAC-sign the short-lived upload tickets. Optional — falls back to
# BLOB_READ_WRITE_TOKEN. Set a dedicated value to rotate independently:
# CONTRIBUTE_TICKET_SECRET=

# ──────────────────────────────────────────────────────────────────────────────
# Vercel Preview Comments → GitHub PR sync (/api/webhooks/vercel-comments)
# Full setup: docs/development/vercel-comment-sync.md
# ──────────────────────────────────────────────────────────────────────────────

# Signing secret shown once when the webhook is created via
# `node scripts/setup-vercel-comment-webhook.mjs`. Used to verify the
# HMAC-SHA1 `x-vercel-signature` header. Unset → the route hard-fails (500),
# it is never silently open. PRODUCTION ONLY — the webhook points at park.fan.
# VERCEL_COMMENT_WEBHOOK_SECRET=

# Fine-grained GitHub PAT with "Contents: read & write" on PArns/park.fan.
# Used only to fire the `vercel-comment` repository_dispatch; the Action itself
# runs with the built-in GITHUB_TOKEN.
# GITHUB_DISPATCH_TOKEN=

# Vercel API token. Optional but recommended: lets the route resolve the git
# branch and preview/production target of a deployment when the comment payload
# does not carry them. Without it, comments whose environment cannot be
# determined are dropped (see VERCEL_COMMENT_SYNC_UNKNOWN).
# VERCEL_API_TOKEN=
# VERCEL_TEAM_ID=

# Repo that receives the dispatch. Defaults to PArns/park.fan.
# VERCEL_COMMENT_SYNC_REPO=PArns/park.fan

# Branch treated as production when Vercel does not send an explicit target.
# Comments on it are ignored. Defaults to "main".
# VERCEL_PRODUCTION_BRANCH=main

# Kill switch — set to "off" to drop every incoming comment webhook.
# VERCEL_COMMENT_SYNC=off

# Escape hatch: sync comments even when the environment could not be determined.
# Off by default so production feedback never lands on an unrelated PR.
# VERCEL_COMMENT_SYNC_UNKNOWN=on
