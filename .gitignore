# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

.idea/
.cursor/

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# user photo contributions — local-dev storage + moderation queue (never commit)
/.uploads
/.data

# typescript
*.tsbuildinfo
next-env.d.ts

# Auto-generated files
build-info.json
lib/hero-images.ts
lib/glossary/client-data.ts
lib/glossary/client-data/
lib/attraction-images.ts
lib/blog/manifest.ts
lib/blog/manifest-bodies.ts
lib/blog/manifest-galleries.ts

# Media database manifests — regenerated from the committed sidecars by
# `pnpm generate:media` in prebuild, exactly like the blog manifests.
# `manifest-parks.ts` is deliberately NOT here: it is the one file that cannot be
# rebuilt without the API, so it is committed and reused when a build is offline.
lib/media/manifest.ts
lib/media/manifest-text.ts
lib/media/manifest-search.ts
lib/media/manifest-hero.ts
lib/media/manifest-hero-lqip.ts

# Auto-generated aspect-ratio crops (scripts/generate-image-crops.mjs) — cut from
# the committed source photos at build time, never hand-authored.
public/media/**/*-16x9.jpg
public/media/**/*-4x3.jpg
public/media/**/*-1x1.jpg

# The pre-media-database photo tree. Everything the site paints now lives under
# public/media; what was left here were 351 orphaned crops with no source images,
# and a `git add -A` swept 282 MB of them into a commit — which then pushed the OG
# function past Vercel's 250 MB limit, because the tracer answers the route's
# runtime read of /public by bundling the whole directory.
/public/images/

*.md
*.txt
*.log

!content/home/*.md
!content/blog/**/*.md
.env*.local

# Docs and project markdown (keep in git)
!/docs/*.md
!/docs/**/*.md
!CLAUDE.md
# The media database's authoring contract lives next to the files it describes.
!/public/media/README.md

# The machine-readable surface: `*.md` and `*.txt` above are meant to keep stray notes and
# scratch files out, but three parts of the app are named after the file they serve — the route
# folders `app/llms.txt/` and `app/auth.md/`, and the Agent Skills whose artifacts are markdown
# on purpose (the discovery index publishes a SHA-256 of the bytes served). Without these lines
# `git add` silently skips them and the build ships a 404.
!/app/**/*.txt/
!/app/**/*.md/
!/app/**/*.txt/**
!/app/**/*.md/**
!/content/agent-skills/**/*.md
package-lock.json

# impeccable design tooling — keep shared config (.impeccable/config.json,
# design.json), ignore per-developer + generated live/annotation state
/.impeccable/config.local.json
/.impeccable/live/
/.impeccable/cache/

# Claude Code — per-developer local settings (not shared)
/.claude/settings.local.json

# OG image render harness output (scripts/render-og.mjs)
.og-preview/

# Coaster render harness output (scripts/render-coaster-elements.mjs)
.coaster-render/

# Lazily fetched message namespaces — regenerated from messages/*.json by
# `pnpm generate:message-chunks` in prebuild (see lib/i18n/route-namespaces.mjs).
lib/i18n/message-chunks/

# Local screenshot harness (scripts/_shot.mjs) — a scratch tool, not part of the repo.
scripts/_shot.mjs
scripts/_probe.mjs
scripts/_contrast.mjs
scripts/_shot2.mjs
